{
	"name": "etfmirror",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "(cd app && bun dev) & bun --watch src/index.ts",
		"prod": "bun run build && bun start",
		"build": "cd app && bun install && bun run build && cd .. && bun install && bun build src/index.ts --outdir=dist --target=bun",
		"start": "bun dist/index.js"
	},
	"devDependencies": {
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"cheerio": "^1.2.0"
	}
}
